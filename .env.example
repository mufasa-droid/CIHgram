# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Required: Supabase Project URL (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Required: Supabase Anonymous / Publishable Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example

# Optional / Server-Only: Supabase Service Role Key
# WARNING: NEVER expose this key to browser / client code. It bypasses RLS.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_example

# ==============================================================================
# Application Configuration
# ==============================================================================
# Base URL of the deployed or local application
NEXT_PUBLIC_APP_URL=http://localhost:3000
